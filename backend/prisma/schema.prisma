// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String
  name              String?
  phone             String?
  totalPoints       Int @default(0)
  passwordResetCode PasswordResetCode?
  role              Role               @default(USER)
  predictions       Prediction[]
  createdAt         DateTime           @default(now())
}

enum Role {
  USER
  ADMIN
}

model PasswordResetCode {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resetCodeHash String
  expiryDate    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Team {
  id              String   @id @default(uuid())
  name            String   @unique
  country         String?
  logo            String?
  players         Player[]

  homeTeamMatches Match[]  @relation("homeTeam")
  awayTeamMatches Match[]  @relation("awayTeam")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Player {
  id          String  @id @default(uuid())
  apiId       String  @unique
  firstName   String
  lastName    String
  age         Int?
  nationality String?
  position    String?
  photo       String?

  teamId      String
  team        Team   @relation(fields: [teamId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Match {
  id                String    @id @default(uuid())
  matchKey          String    @unique

  homeTeamId        String
  awayTeamId        String

  homeTeam          Team      @relation("homeTeam", fields: [homeTeamId], references: [id])
  awayTeam          Team      @relation("awayTeam", fields: [awayTeamId], references: [id])

  homeTeamScore     Int?
  awayTeamScore     Int?

  homePenaltyScore  Int?
  awayPenaltyScore  Int?

  outcome            MatchOutcome?

  finishType        MatchFinishType?

  tournament        Tournament

  status            MatchStatus
  startAt           DateTime

  isCalculated      Boolean @default(false)

  predictions       Prediction[]
  matchAIPrediction MatchAIPrediction[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum MatchStatus {
  UPCOMING
  IN_PROGRESS
  HALF_TIME
  EXTRA_TIME
  PENALTIES
  FINISHED
}

enum MatchFinishType {
  REGULAR
  PENALTIES
}

enum MatchOutcome {
  HOME
  AWAY
  DRAW
}

enum Tournament {
  WORLD_CHAMPIONSHIP
  NPL_ACT
}

model MatchAIPrediction {
  id String @id @default(uuid())
  
  matchId String
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  homeWinProbability Float
  drawProbability Float
  awayWinProbability Float

  model PredictionModel

  @@unique([matchId, model])
}

enum PredictionModel {
  GEMINI
}

model Prediction {
  id        String            @id @default(uuid())
  userId    String
  matchId   String
  user      User              @relation(fields: [userId], references: [id])
  match     Match             @relation(fields: [matchId], references: [id])
  outcome   MatchOutcome
  pointsWon Int               @default(0)
  createAt  DateTime          @default(now())

  @@unique([userId, matchId])
}
